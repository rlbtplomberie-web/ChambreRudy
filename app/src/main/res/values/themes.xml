<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Fond de fenetre transparent : une surface OpenGL est posee derriere la
      fenetre, et tout fond opaque la masquerait. C'est elle qui remplit
      l'ecran en noir.
    -->
    <style name="ThemePleinEcran" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

    <!-- La chambre : fond opaque, c'est une page web et non une surface OpenGL. -->
    <style name="ThemeChambre" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">#0b0718</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

    <!--
      Le PSP a son theme a lui, repris de ton projet.

      JeuActivity herite de AppCompatActivity par PpssppActivity : son theme
      doit etre un theme AppCompat, sinon Android ferme l'activite des son
      ouverture. Et la fenetre reste OPAQUE : une SurfaceView perce elle-meme
      son trou, alors qu'une fenetre transparente laisserait voir le bureau
      du telephone au travers.
    -->
    <style name="ThemePSP" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">false</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
</resources>
