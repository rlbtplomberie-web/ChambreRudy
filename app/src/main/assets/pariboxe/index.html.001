"],"dodge":["data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,"],"damage":["data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,"]};
const fighter=document.getElementById("fighter"),label=document.getElementById("label");
let mode="idle",frame=0,last=0,speed=70,attackBusy=false,guardHeld=false,guardRelease=false;
let attackIndex=0, move=0;
const attacks=["direct1","direct2","kick","uppercut"];
const actions=[...attacks,"dodge","damage"];

function setMode(m){ if(mode!==m){mode=m;frame=0;last=0;} }
function animate(t){
  if(!last) last=t;
  if(!window.__combatReady){
    last=t; frame=0; mode="idle";
    attackBusy=false; guardHeld=false; guardRelease=false; move=0;
    fighter.src=F.idle[0];
    requestAnimationFrame(animate);
    return;
  }
  if(t-last>=speed){
    last=t;
    if(mode==="guard"){
      if(guardHeld){
        if(frame<2) frame++;
        else frame=2; // tant que GARDE reste appuyé : position 3
      }else if(guardRelease){
        if(frame<4) frame++;
        else {guardRelease=false; setMode(move<0?"back":move>0?"forward":"idle");}
      }
    }else if(actions.includes(mode)){
      frame++;
      if(frame>=F[mode].length){
        attackBusy=false;
        setMode(guardHeld?"guard":move<0?"back":move>0?"forward":"idle");
      }
    }else{
      frame=(frame+1)%F[mode].length;
    }
  }
  fighter.src=F[mode][Math.min(frame,F[mode].length-1)];
  requestAnimationFrame(animate);
}
requestAnimationFrame(animate);

function doAttack(){
  if(attackBusy) return;
  attackBusy=true; guardHeld=false; guardRelease=false;
  const a=attacks[attackIndex];
  attackIndex=(attackIndex+1)%attacks.length;
  setMode(a);
  label.textContent=a==="direct1"?"DIRECT 1":a==="direct2"?"DIRECT 2":a==="kick"?"COUP DE PIED":"UPPERCUT";
}
const atk=document.getElementById("attack");
atk.addEventListener("pointerdown",e=>{e.preventDefault();doAttack()});
const dodge=document.getElementById("dodge");
dodge.addEventListener("pointerdown",e=>{
 e.preventDefault(); if(attackBusy)return;
 attackBusy=true; guardHeld=false; guardRelease=false;
 setMode("dodge"); label.textContent="ESQUIVE";
});

const gb=document.getElementById("guard");
gb.addEventListener("pointerdown",e=>{
 e.preventDefault();
 if(attackBusy)return; // le coup reste prioritaire
 guardHeld=true;guardRelease=false;setMode("guard");label.textContent="PROTECTION";
});
function releaseGuard(){
 if(mode==="guard"){guardHeld=false;guardRelease=true;}
}
gb.addEventListener("pointerup",releaseGuard);
gb.addEventListener("pointercancel",releaseGuard);
gb.addEventListener("pointerleave",e=>{if(e.buttons===0)releaseGuard()});

let mult=1.5;


const joy=document.getElementById("joy"),stick=document.getElementById("stick");
let joyId=null;
function joyMoveXY(clientX,clientY){
 const r=joy.getBoundingClientRect(),cx=r.left+r.width/2,cy=r.top+r.height/2;
 let dx=clientX-cx,dy=clientY-cy;
 const max=r.width*.30,d=Math.hypot(dx,dy)||1,k=Math.min(1,max/d);
 stick.style.transform=`translate(${dx*k}px,${dy*k}px)`;
 move=dx>22?1:dx<-22?-1:0;
 if(!attackBusy && mode!=="guard"){
   setMode(move>0?"forward":move<0?"back":"idle");
   label.textContent=move>0?"AVANCE":move<0?"RECULE":"GARDE";
 }
}
function resetJoy(){
 joyId=null; move=0; stick.style.transform="translate(0,0)";
 if(!attackBusy && mode!=="guard"){setMode("idle");label.textContent="GARDE";}
}
joy.addEventListener("pointerdown",e=>{
 e.preventDefault(); joyId=e.pointerId;
 try{joy.setPointerCapture(e.pointerId)}catch(_){}
 joyMoveXY(e.clientX,e.clientY);
},{passive:false});
joy.addEventListener("pointermove",e=>{
 if(joyId===e.pointerId){e.preventDefault();joyMoveXY(e.clientX,e.clientY);}
},{passive:false});
joy.addEventListener("pointerup",e=>{if(joyId===e.pointerId){e.preventDefault();resetJoy();}},{passive:false});
joy.addEventListener("pointercancel",e=>{if(joyId===e.pointerId)resetJoy();},{passive:false});

// secours tactile pour certains navigateurs Android ouvrant un HTML local
joy.addEventListener("touchstart",e=>{
 e.preventDefault(); const t=e.changedTouches[0]; joyMoveXY(t.clientX,t.clientY);
},{passive:false});
joy.addEventListener("touchmove",e=>{
 e.preventDefault(); const t=e.changedTouches[0]; joyMoveXY(t.clientX,t.clientY);
},{passive:false});
joy.addEventListener("touchend",e=>{e.preventDefault();resetJoy();},{passive:false});
</script>
<script>
(()=>{
 const f=document.getElementById("fighter");
 const minus=document.getElementById("sizeMinus");
 const plus=document.getElementById("sizePlus");
 const val=document.getElementById("sizeValue");
 const done=document.getElementById("editDone");
 const again=document.getElementById("editAgain");

 let editing=true;
 let scale=parseFloat(localStorage.getItem("fighterScale")||"1");
 let x=parseFloat(localStorage.getItem("fighterX")||"50");
 let y=parseFloat(localStorage.getItem("fighterY")||"3");
 let dragId=null, sx=0, sy=0, startX=0, startY=0;

 function clamp(v,a,b){return Math.max(a,Math.min(b,v))}
 function apply(){
   scale=clamp(scale,.45,1.8);
   x=clamp(x,5,95);
   y=clamp(y,1.5,55);
   f.style.setProperty("--fighter-scale",scale);
   f.style.left=x+"%";
   f.style.bottom=y+"%";
   val.textContent=Math.round(scale*100)+"%";
 }
 function save(){
   localStorage.setItem("fighterScale",scale);
   localStorage.setItem("fighterX",x);
   localStorage.setItem("fighterY",y);
 }
 function setEditing(on){
   editing=on;
   document.body.classList.toggle("editMode",on);
   f.classList.toggle("editing",on);
   done.style.display=on?"block":"none";
   minus.style.display=on?"block":"none";
   plus.style.display=on?"block":"none";
   val.style.display=on?"inline-block":"none";
   document.getElementById("editTitle").style.display=on?"block":"none";
   again.style.display=on?"none":"block";
 }
 minus.addEventListener("pointerdown",e=>{
   e.preventDefault(); e.stopPropagation(); scale-=.05; apply(); save();
 });
 plus.addEventListener("pointerdown",e=>{
   e.preventDefault(); e.stopPropagation(); scale+=.05; apply(); save();
 });
 done.addEventListener("pointerdown",e=>{
   e.preventDefault(); e.stopPropagation(); save(); setEditing(false);
 });
 again.addEventListener("pointerdown",e=>{
   e.preventDefault(); e.stopPropagation(); setEditing(true);
 });

 f.addEventListener("pointerdown",e=>{
   if(!editing)return;
   e.preventDefault();e.stopPropagation();
   dragId=e.pointerId;sx=e.clientX;sy=e.clientY;startX=x;startY=y;
   try{f.setPointerCapture(e.pointerId)}catch(_){}
 });
 f.addEventListener("pointermove",e=>{
   if(!editing||dragId!==e.pointerId)return;
   e.preventDefault();e.stopPropagation();
   x=startX+(e.clientX-sx)/innerWidth*100;
   y=startY-(e.clientY-sy)/innerHeight*100;
   apply();
 });
 function endDrag(e){
   if(dragId===null)return;
   dragId=null;save();
 }
 f.addEventListener("pointerup",endDrag);
 f.addEventListener("pointercancel",endDrag);

 apply();
 setEditing(true);
})();
</script>

<script>
(()=>{
 const f=document.getElementById("fighter");
 let worldOffset=0;
 let last=performance.now();

 function baseX(){
   const v=parseFloat(localStorage.getItem("fighterX")||"50");
   return Number.isFinite(v)?v:50;
 }
 function tick(t){
   const dt=Math.min(40,t-last); last=t;
   if(!window.__combatReady){ requestAnimationFrame(tick); return; }
   // "move" already comes from the existing joystick: -1 / 0 / +1.
   if(typeof move!=="undefined" && move!==0 && !(typeof guardHeld!=="undefined" && guardHeld)){
      worldOffset += move * dt * 0.018;
      worldOffset=Math.max(-42,Math.min(42,worldOffset));
      f.style.left=(baseX()+worldOffset)+"%";
   }
   requestAnimationFrame(tick);
 }
 requestAnimationFrame(tick);

 // After editor repositioning, preserve current gameplay offset.
 const obs=new MutationObserver(()=>{});
})();
</script>

