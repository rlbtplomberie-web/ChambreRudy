<script id="combat-countdown-lock">
window.__combatReady=false;
(function(){
 function locked(e){
   if(!window.__combatReady && !(e.target && (e.target.id==="pariboxeBegin" || e.target.closest?.("#pariboxeStart")))){
     e.preventDefault();
     e.stopImmediatePropagation();
   }
 }
 ["pointerdown","pointerup","touchstart","touchend","click"].forEach(t=>{
   document.addEventListener(t,locked,true);
 });
})();
</script>

<script id="countdown-real-freeze">
(function(){
  let fx0=null, ex0=null;

  function freezeLoop(){
    if(!window.__combatReady){
      try{
        if(fx0===null && typeof x==="number") fx0=x;
        if(ex0===null && typeof ex==="number") ex0=ex;
        if(fx0!==null && typeof x==="number") x=fx0;
        if(ex0!==null && typeof ex==="number") ex=ex0;

        const f=document.getElementById("fighter");
        const e=document.getElementById("enemy");
        if(f && typeof F!=="undefined" && F.idle){
          f.src=F.idle[0];
        }
        if(e && typeof E!=="undefined" && E.idle){
          e.src=E.idle[0];
        }
      }catch(_){}
    } else {
      fx0=null; ex0=null;
    }
    requestAnimationFrame(freezeLoop);
  }
  requestAnimationFrame(freezeLoop);
})();
</script>
