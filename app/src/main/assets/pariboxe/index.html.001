#damage{display:none!important} /* dégâts = réaction, jamais bouton joueur */
</style>
<script id="real-hit-collision-final">
(()=>{
 function rect(el){return el.getBoundingClientRect()}
 function overlap(a,b){
   return a.left < b.right && a.right > b.left &&
          a.top < b.bottom && a.bottom > b.top;
 }
 function bodyBox(el){
   const r=rect(el);
   return {left:r.left+r.width*.20,right:r.right-r.width*.20,
           top:r.top+r.height*.10,bottom:r.bottom-r.height*.05};
 }
 function rudyHitBox(kind){
   const r=rect(document.getElementById("fighter"));
   // Rudy regarde à droite : impact devant lui.
   if(kind==="kick") return {left:r.left+r.width*.55,right:r.right,
      top:r.top+r.height*.42,bottom:r.top+r.height*.82};
   if(kind==="uppercut") return {left:r.left+r.width*.52,right:r.right,
      top:r.top+r.height*.15,bottom:r.top+r.height*.58};
   return {left:r.left+r.width*.55,right:r.right,
      top:r.top+r.height*.20,bottom:r.top+r.height*.58};
 }
 function cpuHitBox(kind){
   const r=rect(document.getElementById("enemy"));
   // Chauve regarde à gauche : impact devant lui.
   if(kind==="kick"||kind==="lowkick") return {left:r.left,right:r.left+r.width*.48,
      top:r.top+r.height*.42,bottom:r.top+r.height*.86};
   return {left:r.left,right:r.left+r.width*.48,
      top:r.top+r.height*.18,bottom:r.top+r.height*.58};
 }

 window.realRudyHitsCPU=function(kind){
   const f=document.getElementById("fighter"),e=document.getElementById("enemy");
   return overlap(rudyHitBox(kind),bodyBox(e));
 };
 window.realCPUHitsRudy=function(kind){
   const f=document.getElementById("fighter"),e=document.getElementById("enemy");
   return overlap(cpuHitBox(kind),bodyBox(f));
 };
})();
</script>
<script id="fight-engine-final">
(()=>{
const enemy=document.getElementById("enemy"),rudy=document.getElementById("fighter");
const cpuBar=document.getElementById("cpuHp"),rudyBar=document.getElementById("rudyHp");
let cpuHP=100,rudyHP=100,em="idle",ef=0,eBusy=false,ex=65.12054656786727,last=0;
let cpuAttack=null,cpuImpactAt=0,cpuImpactDone=false;
const atk=["direct","kick","lowkick","backfist"];
const duration={direct:650,kick:760,lowkick:760,backfist:700,dodge:620,guard:650,damage:760};
function setE(m){
 if(em===m) return;
 em=m;
 ef=0;
 last=performance.now();
}
function bars(){cpuBar.style.width=cpuHP+"%";rudyBar.style.width=rudyHP+"%";}
function rudyX(){return parseFloat(rudy.style.left)||50}
function near(){return Math.abs(ex-rudyX())<30}
function rudyDodging(){return typeof mode!=="undefined" && mode==="dodge"}
function rudyGuarding(){return typeof guardHeld!=="undefined" && guardHeld}
function rudyReact(){
 if(typeof attackBusy!=="undefined" && !attackBusy){
   attackBusy=true; setMode("damage");
   if(typeof label!=="undefined")label.textContent="DÉGÂTS";
 }
}
function hitRudy(kind){
 if(!window.realCPUHitsRudy(kind))return;
 // Une esquive correctement active annule un DIRECT.
 if(kind==="direct" && rudyDodging()) return;
 // GARDE absorbe le coup : pas d'animation dégâts.
 if(rudyGuarding()) return;
 rudyHP=Math.max(0,rudyHP-(kind==="kick"||kind==="lowkick"?6:4)); bars(); rudyReact();
}
function hitCpu(power){
 if(!window.realRudyHitsCPU((typeof mode!=="undefined"?mode:"direct1"))||em==="dodge"||em==="guard")return;
 cpuHP=Math.max(0,cpuHP-power);bars();eBusy=true;setE("damage");
}
function draw(t){
 if(!last)last=t;
 if(!window.__combatReady){
   last=t; ef=0; em="idle"; eBusy=false;
   enemy.src=E.idle[0];
   enemy.style.setProperty("--enemy-x",ex+"%");
   requestAnimationFrame(draw);
   return;
 }
 const frames=E[em]||E.idle;
 const step=(em==="forward"||em==="back")?118:105;
 if(t-last>=step){last=t;ef++}
 if(ef>=frames.length){
   if(["damage","dodge","guard","direct","kick","lowkick","backfist"].includes(em)){eBusy=false;setE("idle")}
   else ef=0;
 }
 enemy.src=(E[em]||E.idle)[Math.min(ef,(E[em]||E.idle).length-1)];
 enemy.style.setProperty("--enemy-x",ex+"%");
 requestAnimationFrame(draw);
} requestAnimationFrame(draw);

// CPU : IA exécutée DANS le moteur de combat, donc accès réel à eBusy/ex/setE/hitRudy.
let cpuNext=0;
function cpuCenter(el){
 const r=el.getBoundingClientRect();
 return {x:(r.left+r.right)/2,y:(r.top+r.bottom)/2,w:r.width,h:r.height};
}
function cpuCanHit(kind){
 return !!(window.realCPUHitsRudy && window.realCPUHitsRudy(kind));
}
function cpuAnyHit(){
 return cpuCanHit("direct")||cpuCanHit("backfist")||cpuCanHit("kick")||cpuCanHit("lowkick");
}
function cpuThink(t){
 requestAnimationFrame(cpuThink);
 if(t<cpuNext)return;
 cpuNext=t+120;
 if(!window.__combatReady)return;
 if(eBusy||cpuHP<=0||rudyHP<=0)return;

 const a=cpuCenter(rudy), b=cpuCenter(enemy);

 // Il reste du côté droit de Rudy et s'approche jusqu'à portée.
 if(!cpuAnyHit()){
   if(b.x>a.x){
     ex=Math.max(52,ex-.55);
     setE("forward");
   }else{
     ex=Math.min(92,ex+.55);
     setE("forward");
   }
   return;
 }

 const rnd=Math.random();
 if(rnd<.10){eBusy=true;setE("dodge");return;}
 if(rnd<.22){eBusy=true;setE("guard");return;}

 const possible=["direct","backfist","kick","lowkick"].filter(cpuCanHit);
 if(!possible.length)return;
 const kind=possible[Math.floor(Math.random()*possible.length)];
 eBusy=true;cpuAttack=kind;cpuImpactDone=false;setE(kind);

 setTimeout(()=>{
   if(cpuImpactDone)return;
   cpuImpactDone=true;
   if(cpuCanHit(kind))hitRudy(kind);
 },(kind==="direct"||kind==="backfist")?285:350);
}
requestAnimationFrame(cpuThink);

// Les attaques de Rudy font mal au CPU une seule fois au moment d'impact.
let seen="",serial=0;
setInterval(()=>{
 if(!window.__combatReady)return;
 if(typeof mode==="undefined")return;
 if(["direct1","direct2","kick","uppercut"].includes(mode) && mode!==seen){
   let my=++serial,kind=mode;
   setTimeout(()=>{
     if(my!==serial)return;
     hitCpu(kind==="kick"||kind==="uppercut"?7:5);
   },180);
 }
 seen=mode;
},35);

bars();
})();
</script>

