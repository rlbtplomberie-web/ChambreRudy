<style id="cpu-meme-niveau-que-rudy">
/* Le chauve reprend la ligne de pieds et la taille de Rudy */
html body #game #enemy{
 position:absolute!important;
 left:var(--enemy-x,65.12054656786727%)!important;
 right:auto!important;
 top:auto!important;
 bottom:var(--cpu-bottom,3%)!important;
 transform:translateX(-50%) scale(var(--cpu-scale,1))!important;
 transform-origin:center bottom!important;
}
</style>
<script id="cpu-meme-niveau-que-rudy-js">
(function(){
 // Mesures des planches : hauteur du personnage et hauteur des pieds
 // au-dessus du bas de l'image (canevas 980x820).
 var RUDY_H=743, RUDY_PIEDS=30, CPU_H=650, CPU_PIEDS=21, CANVAS_W=980, CANVAS_H=820;
 function sync(){
  var f=document.getElementById("fighter"), e=document.getElementById("enemy"),
      g=document.getElementById("game");
  if(!f||!e||!g) return;
  var gh=g.clientHeight||window.innerHeight;
  if(!gh) return;
  var sc=parseFloat(getComputedStyle(f).getPropertyValue("--fighter-scale"))||1;
  var yPct=parseFloat(f.style.bottom);
  if(!isFinite(yPct)) yPct=parseFloat(localStorage.getItem("fighterY")||"3")||3;
  var kR=Math.min(f.clientWidth/CANVAS_W, f.clientHeight/CANVAS_H);
  var kC=Math.min(e.clientWidth/CANVAS_W, e.clientHeight/CANVAS_H);
  if(!kR||!kC) return;
  // même taille à l'écran que Rudy, multipliée par la taille propre de l'adversaire
  var perso=parseFloat(window.__cpuTaille);
  if(!isFinite(perso)||perso<=0) perso=1;
  var scale=sc*kR*RUDY_H*perso/(kC*CPU_H);
  // même ligne de pieds que Rudy
  var pieds=gh*yPct/100 + RUDY_PIEDS*kR*sc;
  var bottom=(pieds - CPU_PIEDS*kC*scale)/gh*100;
  e.style.setProperty("--cpu-scale",scale);
  e.style.setProperty("--cpu-bottom",bottom+"%");
 }
 sync();
 window.addEventListener("load",sync);
 window.addEventListener("resize",sync);
 window.addEventListener("orientationchange",function(){setTimeout(sync,300)});
 setInterval(sync,500);
})();
</script>

<style id="pariboxe-select-perso-style">
#pariboxeStart.selectPerso{
 background:#000!important;
 display:block!important;
 padding:0!important;
 animation:selFondIn .45s ease both;
}
@keyframes selFondIn{from{opacity:0}to{opacity:1}}
#selStage{
 position:absolute;inset:0;margin:auto;
 aspect-ratio:1672/941;max-width:100%;max-height:100%;
 background-image:url("data:image/webp;base64,");
 background-size:100% 100%;background-repeat:no-repeat;
}
.selCard{
 position:absolute;border-radius:6px;
 background:transparent;border:0;padding:0;
 animation:selCarteIn .5s cubic-bezier(.2,.9,.3,1.3) both;
 transition:transform .18s ease;
 transform-origin:center center;
 touch-action:manipulation;cursor:pointer;
}
@keyframes selCarteIn{from{opacity:0;transform:translateY(38px) scale(.9)}to{opacity:1;transform:none}}
.selCard[data-i="0"]{animation-delay:.10s}
.selCard[data-i="1"]{animation-delay:.22s}
.selCard[data-i="2"]{animation-delay:.34s}
/* cartes verrouillées : voile sombre */
.selCard.verrou::after{
 content:"";position:absolute;inset:0;border-radius:6px;
 background:rgba(0,0,0,.45);
}
.selCard.verrou.actif::after{background:rgba(0,0,0,.22)}
/* carte sélectionnée : cadre qui pulse */
.selCard.actif{z-index:3}
.selCard.actif::before{
 content:"";position:absolute;inset:-7px;border-radius:9px;
 border:4px solid #ffd800;
 box-shadow:0 0 18px 5px rgba(255,216,0,.85),inset 0 0 22px rgba(255,216,0,.45);
 animation:selPulse .85s ease-in-out infinite alternate;
}
@keyframes selPulse{
 from{box-shadow:0 0 12px 3px rgba(255,216,0,.55),inset 0 0 14px rgba(255,216,0,.25);transform:scale(1)}
 to{box-shadow:0 0 30px 10px rgba(255,216,0,.95),inset 0 0 26px rgba(255,216,0,.5);transform:scale(1.02)}
}
.selCard.actif{transform:scale(1.045)}
.selCard.secoue{animation:selSecoue .4s}
@keyframes selSecoue{
 0%,100%{transform:translateX(0) scale(1.045)}
 20%{transform:translateX(-11px) scale(1.045)}
 40%{transform:translateX(10px) scale(1.045)}
 60%{transform:translateX(-7px) scale(1.045)}
 80%{transform:translateX(5px) scale(1.045)}
}
#selBientot{
 position:absolute;left:50%;top:28.5%;transform:translate(-50%,-50%) scale(.8);
 padding:8px 20px;border-radius:12px;
 background:rgba(0,0,0,.85);border:3px solid #b40000;
 color:#fff;font:900 clamp(13px,2.1vw,26px) Arial,sans-serif;
 opacity:0;pointer-events:none;transition:opacity .2s,transform .2s;
 white-space:nowrap;text-shadow:0 2px 3px #000;
}
#selBientot.vu{opacity:1;transform:translate(-50%,-50%) scale(1)}
#selFleches{position:absolute;left:0;right:0;top:59%;pointer-events:none}
.selFleche{
 position:absolute;top:0;transform:translateY(-50%);
 color:#ffd800;font:900 clamp(22px,4vw,48px) Arial,sans-serif;
 text-shadow:0 3px 0 #000,0 0 12px #000;
 animation:selFleche 1s ease-in-out infinite alternate;
 pointer-events:auto;cursor:pointer;padding:10px
}
.selFleche.g{left:26.5%}
.selFleche.d{left:83%}
@keyframes selFleche{from{opacity:.45}to{opacity:1}}
#selAstuce{
 position:absolute;left:50%;bottom:2.5%;transform:translateX(-50%);
 color:#fff;font:900 clamp(10px,1.5vw,18px) Arial,sans-serif;
 text-shadow:0 2px 3px #000;opacity:.9;
 animation:selClignote 1.2s ease-in-out infinite alternate;
 white-space:nowrap;pointer-events:none
}
@keyframes selClignote{from{opacity:.35}to{opacity:1}}
.selIcone{
 position:absolute;object-fit:contain;background:#0b0b0b;border-radius:4px;
 box-shadow:0 0 0 2px rgba(0,0,0,.85);
 animation:selCarteIn .5s cubic-bezier(.2,.9,.3,1.3) .22s both;
 pointer-events:none;
}
.selPlaque{
 position:absolute;display:flex;align-items:center;justify-content:center;
 background:#0b0b0b;border:2px solid #d8a400;border-radius:4px;
 color:#ffd800;font:900 clamp(11px,1.6vw,22px) Arial,sans-serif;
 letter-spacing:1px;text-shadow:0 2px 2px #000;
 animation:selCarteIn .5s cubic-bezier(.2,.9,.3,1.3) .22s both;
 pointer-events:none;
}
#selFlash{
 position:absolute;inset:0;background:#fff;opacity:0;pointer-events:none
}
#selFlash.vu{animation:selFlash .5s ease-out}
@keyframes selFlash{0%{opacity:.9}100%{opacity:0}}
#selNom{
 position:absolute;left:50%;top:22%;transform:translate(-50%,-50%) scale(.6);
 color:#ffd800;font:900 clamp(30px,7vw,90px) Arial,sans-serif;
 text-shadow:0 5px 0 #000,0 0 24px #000;opacity:0;pointer-events:none;
}
#selNom.vu{animation:selNom .9s ease-out forwards}
@keyframes selNom{
 0%{opacity:0;transform:translate(-50%,-50%) scale(.6)}
 35%{opacity:1;transform:translate(-50%,-50%) scale(1.12)}
 100%{opacity:1;transform:translate(-50%,-50%) scale(1)}
}
</style>

<script id="pariboxe-select-perso-js">
(function(){
 var ICONE_MODY="data:image/webp;base64,";
 var ICONE_VALOR="data:image/webp;base64,";
 /* Zones des trois cartes, en % de l'image du décor (1672x941) */
 var CARTES=[
  {i:0,nom:"TH\u00c9O", libre:true, jeu:"E", l:32.3,t:38.6,w:15.6,h:43.2},
  {i:1,nom:"VALOR",     libre:true, jeu:"V", l:49.3,t:38.6,w:15.4,h:41.4,
   icone:ICONE_VALOR, art:{l:49.4,t:38.9,w:15.2,h:34.9}, plaque:{l:49.4,t:74.0,w:15.2,h:5.8}},
  {i:2,nom:"MODY",      libre:true, jeu:"MO",l:65.4,t:38.6,w:15.3,h:41.4,
   icone:ICONE_MODY, art:{l:65.5,t:38.9,w:15.1,h:34.9}, plaque:{l:65.5,t:74.0,w:15.1,h:5.8}}
 ];
 function equiper(jeu,nom){
  // Valor est un peu plus grand que Rudy ; Théo et Mody restent à sa taille
  window.__cpuTaille = (jeu==="V") ? 1.09 : 1;
  window.__cpuJeu = jeu;
  window.__cpuNom = nom || "TH\u00c9O";
  var planches = (jeu==="V" && typeof V!=="undefined") ? V
               : (jeu==="MO" && typeof MO!=="undefined") ? MO : null;
  if(planches && typeof E!=="undefined"){
   Object.keys(planches).forEach(function(k){ E[k]=planches[k]; });
  }
 }
 window.__pariboxeChoixPerso=function(lancerCombat){
  var splash=document.getElementById("pariboxeStart");
  if(!splash){ lancerCombat(); return; }
  var revanche=null;
  try{ revanche=sessionStorage.getItem("pariboxeRejouer"); }catch(e){}
  if(revanche){
   try{ sessionStorage.removeItem("pariboxeRejouer"); }catch(e){}
   var cr=CARTES.filter(function(c){return c.jeu===revanche})[0]||CARTES[0];
   equiper(cr.jeu,cr.nom);
   var hudR=document.querySelector(".enemyHud b");
   if(hudR) hudR.textContent=cr.nom;
   splash.classList.add("hide");
   splash.innerHTML="";
   lancerCombat();
   return;
  }
  splash.innerHTML="";
  splash.classList.remove("hide");
  splash.classList.add("selectPerso");

  var stage=document.createElement("div"); stage.id="selStage"; splash.appendChild(stage);
  var flash=document.createElement("div"); flash.id="selFlash"; stage.appendChild(flash);

  /* portraits et plaques de nom posés sur les cartes verrouillées d'origine */
  CARTES.forEach(function(c){
   if(c.icone && c.art){
    var img=document.createElement("img");
    img.className="selIcone"; img.src=c.icone; img.alt=c.nom;
    img.style.left=c.art.l+"%"; img.style.top=c.art.t+"%";
    img.style.width=c.art.w+"%"; img.style.height=c.art.h+"%";
    stage.appendChild(img);
   }
   if(c.plaque){
    var pl=document.createElement("div");
    pl.className="selPlaque"; pl.textContent=c.nom;
    pl.style.left=c.plaque.l+"%"; pl.style.top=c.plaque.t+"%";
    pl.style.width=c.plaque.w+"%"; pl.style.height=c.plaque.h+"%";
    stage.appendChild(pl);
   }
  });

  var boutons=CARTES.map(function(c){
   var b=document.createElement("button");
   b.type="button"; b.className="selCard"+(c.libre?"":" verrou");
   b.setAttribute("data-i",c.i);
   b.style.left=c.l+"%"; b.style.top=c.t+"%";
   b.style.width=c.w+"%"; b.style.height=c.h+"%";
   b.setAttribute("aria-label",c.nom);
   stage.appendChild(b); return b;
  });

  var fleches=document.createElement("div"); fleches.id="selFleches";
  fleches.innerHTML='<span class="selFleche g">\u25c0</span><span class="selFleche d">\u25b6</span>';
  stage.appendChild(fleches);

  var bientot=document.createElement("div"); bientot.id="selBientot";
  bientot.textContent="COMBATTANT \u00c0 VENIR"; stage.appendChild(bientot);

  var nom=document.createElement("div"); nom.id="selNom"; stage.appendChild(nom);

  var astuce=document.createElement("div"); astuce.id="selAstuce";
  astuce.textContent="APPUIE SUR LE COMBATTANT POUR LE CHOISIR";
  stage.appendChild(astuce);

  var actif=0, fini=false, tBientot=null;
  function afficher(){
   boutons.forEach(function(b,i){ b.classList.toggle("actif",i===actif); });
  }
  function deplacer(d){
   if(fini)return;
   actif=(actif+d+CARTES.length)%CARTES.length;
   afficher();
  }
  function refus(b){
   b.classList.remove("secoue"); void b.offsetWidth; b.classList.add("secoue");
   bientot.classList.add("vu");
   clearTimeout(tBientot);
   tBientot=setTimeout(function(){bientot.classList.remove("vu")},1200);
  }
  function valider(){
   if(fini)return;
   var c=CARTES[actif];
   if(!c.libre){ refus(boutons[actif]); return; }
   fini=true;
   equiper(c.jeu,c.nom);
   var hud=document.querySelector(".enemyHud b");
   if(hud) hud.textContent=c.nom;
   flash.classList.add("vu");
   nom.textContent=c.nom; nom.classList.add("vu");
   astuce.style.display="none";
   fleches.style.display="none";
   setTimeout(function(){
     splash.classList.add("hide");
     splash.classList.remove("selectPerso");
     splash.innerHTML="";
     lancerCombat();
   },1100);
  }
  boutons.forEach(function(b,i){
   b.addEventListener("pointerdown",function(e){
     e.preventDefault(); e.stopPropagation();
     if(fini)return;
     if(actif!==i){ actif=i; afficher(); if(!CARTES[i].libre) refus(b); return; }
     valider();
   },{passive:false});
  });
  fleches.querySelector(".g").addEventListener("pointerdown",function(e){e.preventDefault();e.stopPropagation();deplacer(-1)},{passive:false});
  fleches.querySelector(".d").addEventListener("pointerdown",function(e){e.preventDefault();e.stopPropagation();deplacer(1)},{passive:false});
  document.addEventListener("keydown",function(ev){
   if(fini)return;
   if(ev.key==="ArrowLeft"||ev.key==="q"||ev.key==="a"){deplacer(-1);}
   else if(ev.key==="ArrowRight"||ev.key==="d"){deplacer(1);}
   else if(ev.key==="Enter"||ev.key===" "){ev.preventDefault();valider();}
  });
  afficher();
 };
})();
</script>

<script id="valor-planches">
const V={"idle":["data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,"],"forward":["data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,"],"back":["data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,"],"dodge":["data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,"],"damage":["data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,"],"guard":["data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,"],"direct":["data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,"],"kick":["data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,"],"lowkick":["data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,"],"backfist":["data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,"]};
</script>
<script id="mody-planches">
const MO={"idle":["data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,"],"forward":["data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,"],"back":["data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,"],"dodge":["data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,"],"guard":["data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,"],"damage":["data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,"],"direct":["data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,"],"kick":["data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,"],"lowkick":["data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,"],"backfist":["data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,"]};
</script>
<script id="pariboxe-sons-coups">
(function(){
 /* Sons de combat générés en direct (aucun fichier externe) :
    sifflement du coup lancé, impact quand il touche, KO. */
 var ctx=null;
 function audio(){
  if(!ctx){
   var AC=window.AudioContext||window.webkitAudioContext;
   if(!AC)return null;
   try{ctx=new AC()}catch(e){return null}
  }
  if(ctx.state==="suspended"){try{ctx.resume()}catch(e){}}
  return ctx;
 }
 ["pointerdown","touchstart","click","keydown"].forEach(function(t){
  document.addEventListener(t,function(){audio()},{capture:true,passive:true});
 });

 function bruit(dur){
  var c=audio(); if(!c)return null;
  var n=Math.max(1,Math.floor(c.sampleRate*dur));
  var buf=c.createBuffer(1,n,c.sampleRate), d=buf.getChannelData(0);
  for(var i=0;i<n;i++) d[i]=(Math.random()*2-1);
  var src=c.createBufferSource(); src.buffer=buf; return src;
 }
 function enveloppe(gain,t0,pic,dur){
  gain.gain.setValueAtTime(0.0001,t0);
  gain.gain.exponentialRampToValueAtTime(pic,t0+0.008);
  gain.gain.exponentialRampToValueAtTime(0.0001,t0+dur);
 }
 /* Impact : boum grave + claque */
 function impact(force){
  var c=audio(); if(!c)return;
  var t=c.currentTime, f=force||1;
  var osc=c.createOscillator(), g=c.createGain();
  osc.type="sine";
  osc.frequency.setValueAtTime(190*f,t);
  osc.frequency.exponentialRampToValueAtTime(48,t+0.16);
  enveloppe(g,t,0.55,0.20);
  osc.connect(g).connect(c.destination);
  osc.start(t); osc.stop(t+0.24);

  var n=bruit(0.14); if(!n)return;
  var bp=c.createBiquadFilter(), gn=c.createGain();
  bp.type="bandpass"; bp.frequency.value=1500*f; bp.Q.value=0.8;
  enveloppe(gn,t,0.34,0.11);
  n.connect(bp).connect(gn).connect(c.destination);
  n.start(t); n.stop(t+0.16);
 }
 /* Sifflement du bras ou de la jambe qui fend l'air */
 function souffle(){
  var c=audio(); if(!c)return;
  var t=c.currentTime;
  var n=bruit(0.22); if(!n)return;
  var bp=c.createBiquadFilter(), g=c.createGain();
  bp.type="bandpass"; bp.Q.value=1.4;
  bp.frequency.setValueAtTime(420,t);
  bp.frequency.exponentialRampToValueAtTime(2100,t+0.16);
  g.gain.setValueAtTime(0.0001,t);
  g.gain.exponentialRampToValueAtTime(0.12,t+0.05);
  g.gain.exponentialRampToValueAtTime(0.0001,t+0.2);
  n.connect(bp).connect(g).connect(c.destination);
  n.start(t); n.stop(t+0.22);
 }
 /* KO : coup lourd + résonance */
 function ko(){
  impact(1.35);
  var c=audio(); if(!c)return;
  var t=c.currentTime+0.10;
  var osc=c.createOscillator(), g=c.createGain();
  osc.type="triangle";
  osc.frequency.setValueAtTime(120,t);
  osc.frequency.exponentialRampToValueAtTime(40,t+0.7);
  g.gain.setValueAtTime(0.0001,t);
  g.gain.exponentialRampToValueAtTime(0.4,t+0.03);
  g.gain.exponentialRampToValueAtTime(0.0001,t+0.8);
  osc.connect(g).connect(c.destination);
  osc.start(t); osc.stop(t+0.85);
 }

 /* --- Impacts : on suit les barres de vie --- */
 function suivreBarre(id){
  var el=document.getElementById(id); if(!el)return;
  var avant=parseFloat(el.style.width);
  if(!isFinite(avant)) avant=100;
  new MutationObserver(function(){
   var v=parseFloat(el.style.width);
   if(!isFinite(v))return;
   if(v<avant-0.5){
    var perte=avant-v;
    if(v<=0) ko(); else impact(perte>=11?1.25:1);
   }
   avant=v;
  }).observe(el,{attributes:true,attributeFilter:["style"]});
 }
 suivreBarre("cpuHp"); suivreBarre("rudyHp");

 /* --- Souffle : Rudy --- */
 var vuRudy="";
 setInterval(function(){
  var m=(typeof mode!=="undefined")?mode:null;
  if(m && m!==vuRudy && ["direct1","direct2","kick","uppercut"].indexOf(m)>=0) souffle();
  vuRudy=m;
 },40);

 /* --- Souffle : le chauve (repéré sur l'image affichée) --- */
 (function(){
  var enemy=document.getElementById("enemy");
  if(!enemy || typeof E==="undefined")return;
  var index={};
  function sig(u){return u.length+"|"+u.slice(-32)}
  ["direct","kick","lowkick","backfist"].forEach(function(k){
   if(E[k]&&E[k][1]) index[sig(E[k][1])]=k;
   if(typeof V!=="undefined" && V[k] && V[k][1]) index[sig(V[k][1])]=k;
   if(typeof MO!=="undefined" && MO[k] && MO[k][1]) index[sig(MO[k][1])]=k;
  });
  var dernier="";
  new MutationObserver(function(){
   var u=enemy.getAttribute("src"); if(!u||u===dernier)return;
   dernier=u;
   if(index[sig(u)]) souffle();
  }).observe(enemy,{attributes:true,attributeFilter:["src"]});
 })();
})();
</script>

<style id="pariboxe-fin-style">
#pariboxeStart.finCombat{
 background:#000!important;display:block!important;padding:0!important;
 animation:selFondIn .25s ease both;
}
#finStage{
 position:absolute;inset:0;margin:auto;
 aspect-ratio:1672/941;max-width:100%;max-height:100%;
 background-size:100% 100%;background-repeat:no-repeat;background-position:center;
}
#finBarre{
 position:absolute;left:50%;bottom:3.5%;transform:translateX(-50%);
 display:flex;gap:14px;
}
#finBarre button{
 border:3px solid #fff;border-radius:14px;
 background:rgba(0,0,0,.85);color:#fff;
 font:900 clamp(14px,2.2vw,28px) Arial,sans-serif;
 padding:.45em 1.2em;box-shadow:0 0 0 3px #b40000,0 5px 16px #000;
 touch-action:manipulation;
 animation:finBouton .9s ease-in-out infinite alternate;
}
#finBarre button.retour{box-shadow:0 0 0 3px #087d20,0 5px 16px #000}
@keyframes finBouton{from{transform:scale(1)}to{transform:scale(1.05)}}
</style>
<script id="pariboxe-fin-combat">
(function(){
 var IMG={
  rudy_theo:"",
  rudy_valor:"",
  rudy_mody:"",
  mody:"",
  theo:"",
  valor:""
 };
 var affiche=false;
 function ecran(clef){
  if(affiche)return;
  affiche=true;
  window.__combatReady=false;               // les combattants se figent
  if(window.__musiqueCombat) window.__musiqueCombat.arreter();
  var splash=document.getElementById("pariboxeStart");
  if(!splash)return;
  splash.innerHTML="";
  splash.classList.remove("selectPerso");
  splash.classList.remove("hide");
  splash.classList.add("finCombat");
  var stage=document.createElement("div"); stage.id="finStage";
  stage.style.backgroundImage='url("data:image/webp;base64,'+IMG[clef]+'")';
  splash.appendChild(stage);
  var barre=document.createElement("div"); barre.id="finBarre";
  var rejouer=document.createElement("button"); rejouer.type="button"; rejouer.textContent="REJOUER";
  var retour=document.createElement("button"); retour.type="button"; retour.className="retour"; retour.textContent="RETOUR";
  barre.appendChild(rejouer); barre.appendChild(retour); stage.appendChild(barre);
  function recharge(revanche){
   try{
    if(revanche) sessionStorage.setItem("pariboxeRejouer", window.__cpuJeu||"E");
    else sessionStorage.removeItem("pariboxeRejouer");
   }catch(e){}
   location.reload();
  }
  rejouer.addEventListener("pointerdown",function(e){e.preventDefault();e.stopPropagation();recharge(true)},{passive:false});
  retour.addEventListener("pointerdown",function(e){e.preventDefault();e.stopPropagation();recharge(false)},{passive:false});
  document.addEventListener("keydown",function(ev){
   if(!affiche)return;
   if(ev.key==="Enter"||ev.key===" ") recharge(true);
   else if(ev.key==="Escape"||ev.key==="Backspace") recharge(false);
  });
 }
 // Surveillance des barres de vie : mesure réelle à l'écran, vérifiée en continu.
 var combatCommence=false;
 function reste(id){
  var el=document.getElementById(id);
  if(!el||!el.parentElement) return -1;
  var v=parseFloat(el.style.width);
  if(isFinite(v)) return v;                       // valeur posée par le moteur
  var l=el.getBoundingClientRect().width;
  var t=el.parentElement.getBoundingClientRect().width;
  return (t>0) ? (l/t*100) : -1;
 }
 function verifie(){
  if(affiche) return;
  if(window.__combatReady) combatCommence=true;
  if(!combatCommence) return;
  var cpu=reste("cpuHp"), rudy=reste("rudyHp");
  var jeu=window.__cpuJeu;
  var gagneRudy = (jeu==="V") ? "rudy_valor" : (jeu==="MO") ? "rudy_mody" : "rudy_theo";
  var perdRudy  = (jeu==="V") ? "valor"      : (jeu==="MO") ? "mody"      : "theo";
  if(cpu>=0 && cpu<1)        ecran(gagneRudy);   // le CPU tombe : Rudy gagne
  else if(rudy>=0 && rudy<1) ecran(perdRudy);    // Rudy tombe : le CPU gagne
 }
 setInterval(verifie,150);
 ["cpuHp","rudyHp"].forEach(function(id){
  var el=document.getElementById(id);
  if(el) new MutationObserver(verifie).observe(el,{attributes:true,attributeFilter:["style"]});
 });
})();
</script>

<script id="pariboxe-musique-combat">
(function(){
 var audio=null, voulu=false;
 function prepare(){
  if(audio) return audio;
  audio=new Audio("data:audio/mpeg;base64,");
  audio.loop=true;
  audio.volume=0.22;
  audio.preload="auto";
  return audio;
 }
 function jouer(){
  var a=prepare();
  var p=a.play();
  if(p && p.catch) p.catch(function(){});   // relancée au prochain appui si le navigateur refuse
 }
 function relance(){ if(voulu && audio && audio.paused) jouer(); }
 ["pointerdown","touchstart","click"].forEach(function(t){
  document.addEventListener(t,relance,{capture:true,passive:true});
 });
 window.__musiqueCombat={
  demarrer:function(){ voulu=true; var a=prepare(); try{a.currentTime=0;}catch(e){} jouer(); },
  arreter:function(){ voulu=false; if(audio){ try{audio.pause(); audio.currentTime=0;}catch(e){} } }
 };
})();
</script>

<style id="pariboxe-finition-style">
/* Les combattants s'intègrent au décor : légère patine nocturne + ombre portée au sol */
html body #game #fighter,
html body #game #enemy{
 filter:brightness(.93) contrast(1.06) saturate(1.04)
        drop-shadow(0 9px 5px rgba(0,0,0,.5))!important;
 -webkit-filter:brightness(.93) contrast(1.06) saturate(1.04)
        drop-shadow(0 9px 5px rgba(0,0,0,.5))!important;
}

/* Ambiance : halo de ring au sol et vignettage sur les bords */
#ambiance{
 position:absolute;inset:0;pointer-events:none;z-index:2;
 background:
  radial-gradient(60% 34% at 50% 88%, rgba(255,196,110,.16), rgba(255,170,80,.05) 55%, transparent 75%),
  radial-gradient(120% 90% at 50% 45%, transparent 55%, rgba(0,0,0,.42) 100%);
 mix-blend-mode:normal;
}
#impactFlash{
 position:absolute;inset:0;pointer-events:none;z-index:45;opacity:0;
 background:radial-gradient(70% 60% at 50% 55%, rgba(255,255,255,.55), transparent 70%);
}
#impactFlash.coup{animation:flashCoup .18s ease-out}
#impactFlash.recu{animation:flashRecu .26s ease-out}
@keyframes flashCoup{0%{opacity:.55}100%{opacity:0}}
@keyframes flashRecu{0%{opacity:.7;background:radial-gradient(75% 65% at 50% 55%,rgba(255,60,40,.6),transparent 72%)}
                     100%{opacity:0;background:radial-gradient(75% 65% at 50% 55%,rgba(255,60,40,.6),transparent 72%)}}

/* Barres de vie : plus nettes, dégradé qui rougit quand ça sent le K.O. */
html body #game #hudFight{
 z-index:60!important;
 filter:drop-shadow(0 3px 5px rgba(0,0,0,.8));
}
html body #game #hudFight b{
 display:inline-block;padding:0 2px;
 color:#ffe27a;letter-spacing:1.5px;
 font:900 clamp(11px,1.5vw,19px) Arial,sans-serif;
 text-shadow:0 2px 0 #000,0 0 8px rgba(0,0,0,.9);
}
html body #game .hp{
 height:15px!important;border:2px solid #f0e2b0!important;border-radius:9px!important;
 background:linear-gradient(#141414,#2a2a2a)!important;
 box-shadow:inset 0 2px 4px rgba(0,0,0,.9),0 0 10px rgba(0,0,0,.6)!important;
 overflow:hidden!important;
}
html body #game .hp i{
 background:linear-gradient(#7ef29a,#19a64a 55%,#0b6b2e)!important;
 box-shadow:inset 0 2px 0 rgba(255,255,255,.35)!important;
 transition:width .22s ease-out,background .3s!important;
}
html body #game .hp i.moyen{background:linear-gradient(#ffe066,#e0a21a 55%,#8a5e05)!important}
html body #game .hp i.bas{background:linear-gradient(#ff8a7a,#c31c10 55%,#7a0d05)!important}
@media(max-height:520px){
 html body #game .hp{height:11px!important}
}

/* Étiquette du geste : plus sobre et plus lisible */
html body #game #label{
 background:linear-gradient(rgba(0,0,0,.82),rgba(18,18,18,.82))!important;
 border:2px solid rgba(255,226,122,.55)!important;
 color:#ffe27a!important;letter-spacing:2px;
 box-shadow:0 4px 14px rgba(0,0,0,.6)!important;
}
</style>
<script id="pariboxe-finition-js">
(function(){
 var jeu=document.getElementById("game");
 if(!jeu) return;
 var amb=document.createElement("div"); amb.id="ambiance"; jeu.appendChild(amb);
 var fl=document.createElement("div"); fl.id="impactFlash"; jeu.appendChild(fl);

 function flash(classe){
  fl.classList.remove("coup","recu"); void fl.offsetWidth; fl.classList.add(classe);
 }
 function largeur(el){
  var v=parseFloat(el.style.width);
  if(isFinite(v)) return v;
  var p=el.parentElement;
  return (p && p.getBoundingClientRect().width>0)
   ? el.getBoundingClientRect().width/p.getBoundingClientRect().width*100 : 100;
 }
 function teinte(el,v){
  el.classList.toggle("moyen", v<=55 && v>25);
  el.classList.toggle("bas", v<=25);
 }
 var cpu=document.getElementById("cpuHp"), rudy=document.getElementById("rudyHp");
 if(!cpu||!rudy) return;
 var vCpu=largeur(cpu), vRudy=largeur(rudy);
 setInterval(function(){
  var a=largeur(cpu), b=largeur(rudy);
  if(a<vCpu-0.5)  flash("coup");   // Rudy touche
  if(b<vRudy-0.5) flash("recu");   // Rudy encaisse
  vCpu=a; vRudy=b;
  teinte(cpu,a); teinte(rudy,b);
 },100);
})();
</script>
