<script type="text/plain" id="cpu-ai-old">
(()=>{
 const enemy=document.getElementById("enemy");
 const rudy=document.getElementById("fighter");
 const cpuHpEl=document.getElementById("cpuHp"), rudyHpEl=document.getElementById("rudyHp");
 let emode="idle", eframe=0, elast=0, eBusy=false, ex=65.12054656786727;
 let cpuHP=100,rudyHP=100,lastCpuHit=0,lastRudyHit=0;
 const enemyActions=["direct","kick","lowkick","backfist"];
 const actionModes=new Set(["direct","kick","lowkick","backfist","damage","dodge","guard"]);
 function eset(m){emode=m;eframe=0;elast=0;}
 function drawEnemy(t){
   if(!elast)elast=t;
   if(t-elast>=105){
     elast=t;
     if(actionModes.has(emode)){
       eframe++;
       if(eframe>=E[emode].length){eBusy=false;eset("idle");}
     }else eframe=(eframe+1)%E[emode].length;
   }
   enemy.src=E[emode][Math.min(eframe,E[emode].length-1)];
   enemy.style.setProperty("--enemy-x",ex+"%");
   requestAnimationFrame(drawEnemy);
 }
 requestAnimationFrame(drawEnemy);

 function hp(){
   cpuHpEl.style.width=Math.max(0,cpuHP)+"%";
   rudyHpEl.style.width=Math.max(0,rudyHP)+"%";
 }
 function enemyDamage(n=9){
   if(cpuHP<=0)return;
   cpuHP=Math.max(0,cpuHP-n); hp(); eBusy=true; eset("damage");
   if(cpuHP<=0){setTimeout(()=>{cpuHP=100;rudyHP=100;hp();ex=72;eBusy=false;eset("idle")},1300);}
 }
 function rudyDamage(n=8){
   if(rudyHP<=0)return;
   rudyHP=Math.max(0,rudyHP-n); hp();
   if(typeof attackBusy!=="undefined" && !attackBusy){
     attackBusy=true; setMode("damage"); label.textContent="DÉGÂTS";
   }
   if(rudyHP<=0)setTimeout(()=>{cpuHP=100;rudyHP=100;hp();ex=72},1300);
 }

 // Détecte la proximité en pourcentage d'écran.
 function closeEnough(){return Math.abs(ex-(parseFloat(rudy.style.left)||50))<29;}

 // Les attaques de Rudy frappent réellement le CPU au milieu de l'animation.
 const oldDoAttack=window.doAttack || doAttack;
 let prevMode="";
 setInterval(()=>{
   if(typeof mode!=="undefined"){
     const offensive=["direct1","direct2","kick","uppercut"];
     if(offensive.includes(mode) && mode!==prevMode){
       setTimeout(()=>{
         if(closeEnough() && emode!=="dodge" && emode!=="guard" && Date.now()-lastRudyHit>350){
           lastRudyHit=Date.now(); enemyDamage(mode==="kick"||mode==="uppercut"?13:9);
         }
       },170);
     }
     prevMode=mode;
   }
 },40);

 // CPU : avance/recul, esquive/garde et utilise TOUS ses gestes d'attaque.
 function cpuThink(){
   if(eBusy||cpuHP<=0)return;
   const rx=parseFloat(rudy.style.left)||50;
   const dist=ex-rx;
   const rnd=Math.random();

   if(dist>31){
     eset("forward"); ex=Math.max(58,ex-2.2); // vers Rudy = gauche
     setTimeout(()=>{if(!eBusy)eset("idle")},420);
     return;
   }
   if(dist<19){
     eset("back"); ex=Math.min(86,ex+2.5);
     setTimeout(()=>{if(!eBusy)eset("idle")},420);
     return;
   }

   if(rnd<.14){eBusy=true;eset("dodge");return;}
   if(rnd<.27){eBusy=true;eset("guard");return;}

   eBusy=true;
   const a=enemyActions[Math.floor(Math.random()*enemyActions.length)];
   eset(a);
   setTimeout(()=>{
     if(closeEnough() && Date.now()-lastCpuHit>450){
       lastCpuHit=Date.now();
       rudyDamage(a==="kick"||a==="lowkick"?11:8);
     }
   },190);
 }
 /* cpuThink concurrent désactivé */

 // Quand Rudy esquive, le CPU peut rater son coup.
 const originalRudyDamage=rudyDamage;
 hp();
})();
</script>

