<style id="all-controls-authoritative">
/* CPU devant Rudy */
html body #game #enemy{
 left:var(--enemy-x,72%)!important;
 right:auto!important;
 pointer-events:none!important;
}

/* Tous les contrôles joueurs doivent recevoir le tactile */
#joy,#guard,#attack,#dodge,#speed{
 pointer-events:auto!important;
 z-index:9999!important;
 touch-action:none!important;
 opacity:1!important;
}
</style>

<script id="all-controls-touch-fix">
(function(){
 document.body.classList.remove("editMode");

 const joy=document.getElementById("joy");
 const guard=document.getElementById("guard");
 const attack=document.getElementById("attack");
 const dodge=document.getElementById("dodge");
 const speed=document.getElementById("speed");

 /* Ne recrée pas les actions : on convertit seulement le tactile Android
    vers les événements déjà utilisés par le moteur original. */
 function mouse(btn,type){
   if(!btn)return;
   btn.dispatchEvent(new MouseEvent(type,{bubbles:true,cancelable:true,view:window}));
 }

 if(attack){
   attack.addEventListener("pointerdown",function(e){
     if(e.pointerType==="mouse")return;
     e.preventDefault(); mouse(attack,"mousedown"); mouse(attack,"click");
   },{passive:false});
 }
 if(dodge){
   dodge.addEventListener("pointerdown",function(e){
     if(e.pointerType==="mouse")return;
     e.preventDefault(); mouse(dodge,"mousedown"); mouse(dodge,"click");
   },{passive:false});
 }
 if(speed){
   speed.addEventListener("pointerdown",function(e){
     if(e.pointerType==="mouse")return;
     e.preventDefault(); mouse(speed,"click");
   },{passive:false});
 }

 /* GARDE : appui = garde, relâchement = fin de garde */
 if(guard){
   guard.addEventListener("pointerdown",function(e){
     if(e.pointerType==="mouse")return;
     e.preventDefault();
     if(guard.setPointerCapture) try{guard.setPointerCapture(e.pointerId)}catch(_){}
     mouse(guard,"mousedown");
   },{passive:false});
   function guardUp(e){
     if(e.pointerType==="mouse")return;
     e.preventDefault(); mouse(guard,"mouseup");
   }
   guard.addEventListener("pointerup",guardUp,{passive:false});
   guard.addEventListener("pointercancel",guardUp,{passive:false});
 }

 /* Le joystick conserve sa logique tactile originale : on garantit seulement
    qu'aucune couche du CPU ne puisse l'intercepter. */
 if(joy) joy.style.pointerEvents="auto";
})();
</script>

