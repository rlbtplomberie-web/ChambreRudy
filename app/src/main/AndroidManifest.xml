<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Dreamcast, DS et 3DS rendent l'image par OpenGL ES 3 -->
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />

    <!--
         L'acces aux fichiers, borne aux anciens Android.

         Depuis Android 11 ces autorisations ne servent plus a rien : le
         systeme refuse l'ecriture externe d'office, et la lecture passe par
         le selecteur de documents. Mais tant qu'elles sont declarees sans
         limite, les emulateurs les DEMANDENT, et Rudy voit une fenetre
         « autoriser / ne pas autoriser » qui ne peut mener a rien.

         En les bornant, Android ne les propose plus du tout sur les
         telephones recents : plus de fenetre, et rien n'est perdu — chaque
         emulateur ecrit dans le dossier de l'application, qui n'exige aucune
         autorisation.
    -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name="com.rudy.chambre.Chambre"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="RetroRom"
        android:supportsRtl="true"
        android:hardwareAccelerated="true"
        android:requestLegacyExternalStorage="true"
        android:largeHeap="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/ThemePleinEcran"
        tools:replace="android:theme,android:label,android:icon,android:allowBackup,android:supportsRtl">

        <!-- La chambre, dessinee en natif : l'ecran d'accueil -->
        <activity
            android:name="com.rudy.chambre.ChambreActivity"
            android:exported="true"
            android:screenOrientation="fullUser"
            android:theme="@style/ThemeChambre"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- La bibliotheque et le livre, en natif -->
        <activity
            android:name="com.rudy.chambre.livre.LivreActivity"
            android:exported="false"
            android:screenOrientation="fullUser"
            android:theme="@style/ThemeChambre"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|density" />

        <!-- L'atelier de dessin, en natif -->
        <activity
            android:name="com.rudy.chambre.atelier.AtelierActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/ThemeChambre"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|density" />

        <!-- Le poker et le blackjack, en natif -->
        <activity
            android:name="com.rudy.chambre.cartes.PokerActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/ThemeChambre"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|density" />
        <activity
            android:name="com.rudy.chambre.cartes.BlackjackActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/ThemeChambre"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|density" />

        <!-- Le Monopoly, en natif -->
        <activity
            android:name="com.rudy.chambre.monopoly.MonopolyActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/ThemeChambre"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|density" />

        <!-- Le jeu d'echecs, en natif -->
        <activity
            android:name="com.rudy.chambre.echecs.EchecsActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/ThemeChambre"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|density" />

        <!-- Le jeu de dames, en natif -->
        <activity
            android:name="com.rudy.chambre.dames.DamesActivity"
