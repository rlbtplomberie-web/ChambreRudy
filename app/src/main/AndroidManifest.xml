<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Dreamcast, DS et 3DS rendent l'image par OpenGL ES 3 -->
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />

    <!-- Mega Drive, Game Boy et GBA ouvrent la cartouche par son chemin reel -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <!-- reclamees par le moteur de PPSSPP -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name="com.rudy.chambre.Chambre"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="La chambre de Rudy"
        android:supportsRtl="true"
        android:hardwareAccelerated="true"
        android:requestLegacyExternalStorage="true"
        android:largeHeap="true"
        android:theme="@style/ThemePleinEcran">

        <!-- La chambre, dessinee en natif : l'ecran d'accueil -->
        <activity
            android:name="com.rudy.chambre.ChambreActivity"
            android:exported="true"
            android:screenOrientation="fullUser"
            android:theme="@style/ThemeChambre"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- La bibliotheque et le lecteur de livres -->
        <activity
            android:name="com.rudy.chambre.LivreActivity"
            android:exported="false"
            android:screenOrientation="fullUser"
            android:theme="@style/ThemeChambre"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|density" />

        <!-- Les jeux, les vitrines et l'atelier, ouverts par-dessus -->
        <activity
            android:name="com.rudy.chambre.PageActivity"
            android:exported="false"
            android:screenOrientation="fullUser"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|density"
            android:theme="@style/ThemeChambre" />

        <!-- L'ancienne chambre en page web, gardee sous la main -->
        <activity
            android:name="com.rudy.chambre.MainActivity"
            android:exported="false"
            android:screenOrientation="fullSensor"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|density"
            android:theme="@style/ThemeChambre" />

        <!-- NES : reglages repris de son projet -->
        <activity
            android:name="com.skinnes.app.MainActivity"
            android:exported="false"
            android:screenOrientation="fullSensor"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|density"
            android:theme="@style/ThemePleinEcran" />

        <!-- Super Nintendo : reglages repris de son projet -->
        <activity
            android:name="com.skinsnes.app.MainActivity"
            android:exported="false"
            android:screenOrientation="fullSensor"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|density"
            android:theme="@style/ThemePleinEcran" />

        <!-- Game Boy : reglages repris de son projet -->
        <activity
            android:name="com.gbgbc.app.MainActivity"
            android:exported="false"
            android:screenOrientation="fullSensor"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density"
            android:theme="@style/ThemePleinEcran" />

        <!-- Game Boy Advance : reglages repris de son projet -->
        <activity
            android:name="com.skingba.app.MainActivity"
            android:exported="false"
            android:screenOrientation="fullSensor"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density"
            android:theme="@style/ThemePleinEcran" />

        <!-- Mega Drive : reglages repris de son projet -->
        <activity
            android:name="com.skinmd.app.MainActivity"
            android:exported="false"
            android:screenOrientation="fullSensor"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density"
            android:theme="@style/ThemePleinEcran" />

        <!-- Nintendo 64 : habillage de Rudy, coeur Mupen64Plus -->
        <activity
            android:name="com.skinn64.app.MainActivity"
            android:exported="false"
            android:screenOrientation="fullSensor"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|density"
            android:theme="@style/ThemePleinEcran" />

        <!-- PlayStation : reglages repris de son projet -->
        <activity
            android:name="com.skinps1.app.MainActivity"
            android:exported="false"
            android:screenOrientation="fullSensor"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|density"
            android:theme="@style/ThemePleinEcran" />

        <!-- Dreamcast : reglages repris de son projet -->
        <activity
            android:name="com.skindc.app.MainActivity"
            android:exported="false"
            android:screenOrientation="fullSensor"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|density"
            android:theme="@style/ThemePleinEcran" />

        <!-- Nintendo DS : reglages repris de son projet -->
        <activity
            android:name="com.skinds.app.MainActivity"
            android:exported="false"
            android:screenOrientation="fullSensor"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|density"
            android:theme="@style/ThemePleinEcran" />

        <!-- GameCube et Wii : reglages repris de ton projet -->
        <activity
            android:name="com.skingc.app.MainActivity"
            android:exported="false"
            android:screenOrientation="fullSensor"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|density"
            android:theme="@style/ThemePleinEcran" />

        <!-- PSP : le moteur officiel de PPSSPP, reglages repris de ton projet -->
        <activity
            android:name="com.skinpsp.app.JeuActivity"
            android:exported="false"
            android:screenOrientation="fullSensor"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|navigation|smallestScreenSize|density|uiMode"
            android:launchMode="singleTask"
            android:theme="@style/ThemePSP">
            <meta-data android:name="android.window.PROPERTY_COMPAT_ALLOW_RESTRICTED_RESIZABILITY"
                       android:value="true" />
        </activity>
        <activity android:name="org.ppsspp.ppsspp.DocumentResultProxyActivity"
                  android:exported="false" android:theme="@style/ThemePSP" />
        <activity android:name="org.ppsspp.ppsspp.ImageResultProxyActivity"
                  android:exported="false" android:theme="@style/ThemePSP" />
        <activity android:name="org.ppsspp.ppsspp.ShortcutActivity"
                  android:exported="false" android:theme="@style/ThemePSP" />

        <!-- Nintendo 3DS : reglages repris de son projet -->
        <activity
            android:name="com.skin3ds.app.MainActivity"
            android:exported="false"
            android:screenOrientation="fullSensor"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|density"
            android:theme="@style/ThemePleinEcran" />

    </application>
</manifest>
